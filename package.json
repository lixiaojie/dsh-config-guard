{
  "name": "dsh-config-guard",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        ">=0.2.1-rc.5": "compatible"
      },
      "requires": [
        "webServer",
        "configEditor",
        "pluginManager",
        "appReady"
      ],
      "testedOn": "0.2.2-rc.1"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "node test/smoke.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/routes.js"
  },
  "description": "Read-only configuration-inheritance and workspace-health reporter for DeepSeek Harness",
  "author": "xiaojieli",
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "config",
    "diagnostics",
    "read-only"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lixiaojie/dsh-config-guard.git"
  },
  "homepage": "https://github.com/lixiaojie/dsh-config-guard#readme",
  "bugs": {
    "url": "https://github.com/lixiaojie/dsh-config-guard/issues"
  }
}
